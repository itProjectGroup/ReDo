<Window x:Class="ReDo.Windows.ImageCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture image" WindowStyle="None" AllowsTransparency="True"
        Background="#40000000" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Cursor="Cross"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyDown="Window_KeyDown">
    <Grid>
        <Canvas x:Name="SelectionCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRect" Stroke="#FF2563EB" StrokeThickness="2"
                       Fill="#402563EB" Visibility="Collapsed"/>
        </Canvas>
        <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0" FontSize="16" Foreground="White" TextAlignment="Center"
                   Text="Drag to select the UI element to click (Esc to cancel)"/>
    </Grid>
</Window>
