<Window x:Class="ReDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ReDo.ViewModels"
        xmlns:converters="clr-namespace:ReDo.Converters"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="ReDo - Record and Playback"
        MinWidth="380" MinHeight="420" Width="550" Height="480"
        WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="14">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <StackPanel x:Key="PlayPauseBtnCollection">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                     Data="{Binding BtnData.btnPath}" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="{Binding BtnData.btnName}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Key="StopBtnCollection">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                     Data="{Binding BtnStop.btnPath}" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="{Binding BtnStop.btnName}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Key="PlaybackBtnCollection">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Width="20" Height="20" Stretch="Uniform" Fill="White"
                     Data="{Binding BtnPlayback.btnPath}" VerticalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="{Binding BtnPlayback.btnName}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0" Grid.Column="1"/>
            </Grid>
        </StackPanel>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>

        <Style x:Key="AddStepActionItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepActionMenuItemTemplate" DataType="{x:Type viewModels:StepActionItemViewModel}">
            <Button Style="{StaticResource AddStepActionItemButton}"
                    Click="AddStepAction_OnClick" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0"
                            Background="{Binding AccentColorHex, Converter={StaticResource HexToBrush}}">
                        <fa:ImageAwesome Icon="{Binding Icon}" Width="16" Height="16" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecordedStepTemplate" DataType="{x:Type viewModels:RecordedStepViewModel}">
            <Border Background="#F1F5F9" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"
                               VerticalAlignment="Center" MinWidth="20"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StepType}" Value="Key">
                                        <Setter Property="Background" Value="#6366F1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StepType}" Value="Delay">
                                        <Setter Property="Background" Value="#64748B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StepType}" Value="ImageClick">
                                        <Setter Property="Background" Value="#EA580C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <!-- Column 4: Edit action per step type -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Image click: Recapture template -->
                        <Button Width="32" Height="32" Padding="0" ToolTip="Recapture image"
                                Click="RecaptureImage_OnClick" Tag="{Binding}" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepType}" Value="ImageClick">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                        <fa:ImageAwesome Icon="PictureOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Click: Reselect position (target/crosshairs) -->
                        <Button Width="32" Height="32" Padding="0" ToolTip="Reselect position"
                                Click="ReselectClick_OnClick" Tag="{Binding}" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepType}" Value="Click">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                        <fa:ImageAwesome Icon="Crosshairs" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Wait: Edit delay (only when Edit clicked) -->
                        <Button Width="32" Height="32" Padding="0" ToolTip="Edit wait time"
                                Click="WaitEdit_OnClick" Tag="{Binding}" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepType}" Value="Delay">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                        <fa:ImageAwesome Icon="Edit" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Key: Change key -->
                        <Button Width="32" Height="32" Padding="0" ToolTip="Change key"
                                Click="ChangeKey_OnClick" Tag="{Binding}" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StepType}" Value="Key">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                        <fa:ImageAwesome Icon="Edit" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Delete step (all types) -->
                        <Button Width="32" Height="32" Padding="0" ToolTip="Delete step"
                                Click="DeleteStep_OnClick" Tag="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                        <fa:ImageAwesome Icon="Trash" Width="16" Height="16" Foreground="#DC2626"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#FEE2E2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu bar with subtle styling -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <Menu Padding="8,4,12,4">
                <MenuItem Header="File" FontWeight="Normal">
                    <MenuItem Header="Import" Click="Import_OnClick"/>
                    <MenuItem Header="Export" Click="Export_OnClick"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="OnExit_OnClick"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- Action buttons -->
        <Border Grid.Row="1" Padding="20,16" Background="White" Margin="16,16,16,0"
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn_start" Height="52" Content="{StaticResource PlayPauseBtnCollection}"
                        VerticalAlignment="Stretch" Margin="0,0,6,0" Grid.Column="0" Click="StartButton_Click"/>
                <Button x:Name="btn_playback" Height="52" Content="{StaticResource PlaybackBtnCollection}"
                        VerticalAlignment="Stretch" Margin="3,0" Grid.Column="1" Click="PlaybackButton_Click"/>
                <Button x:Name="btn_stop" Height="52" Content="{StaticResource StopBtnCollection}"
                        VerticalAlignment="Stretch" Margin="6,0,0,0" Grid.Column="2" Click="StopButton_Click"/>
            </Grid>
        </Border>

        <!-- Content card: How to use (when no steps) or Recorded steps list -->
        <Border Grid.Row="2" Margin="16,12,16,12" Padding="20,16"
                Background="White" BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,12">
                    <Run Text="Steps"/>
                    <Run Text=" ("/>
                    <Run Text="{Binding RecordedStepsCount}"/>
                    <Run Text=")"/>
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MinHeight="100">
                    <StackPanel>
                        <TextBlock Visibility="{Binding HasRecordedSteps, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="No steps yet. Record actions or tap + below to add steps."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecordedSteps}"
                                      ItemTemplate="{StaticResource RecordedStepTemplate}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Add step (+) -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="btnAddStep" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="40" Height="40" Padding="0" ToolTip="Add step"
                            Click="AddStepButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="addBorder" Width="40" Height="40" CornerRadius="20"
                                                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5">
                                                <fa:ImageAwesome x:Name="addIcon" Icon="Plus" Width="14" Height="14"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="addBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="addBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter TargetName="addIcon" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Popup x:Name="AddActionPopup" PlacementTarget="{Binding ElementName=btnAddStep}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="-8"
                           Opened="AddActionPopup_OnOpened">
                        <Border Background="White" CornerRadius="10" Padding="6"
                                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1"
                                MinWidth="300" MaxWidth="340">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Add step" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="12,6,12,8"/>

                                <!-- Search -->
                                <Border Margin="6,0,6,8" CornerRadius="8" BorderBrush="#E2E8F0"
                                        BorderThickness="1" Background="#F8FAFC">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <fa:ImageAwesome Icon="Search" Width="14" Height="14"
                                                         Foreground="{StaticResource TextSecondaryBrush}"
                                                         Margin="10,0,4,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AddStepSearchBox" Grid.Column="1"
                                                 Text="{Binding StepActionSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="4,8,10,8" FontSize="13"
                                                 VerticalContentAlignment="Center"
                                                 Foreground="{StaticResource TextPrimaryBrush}">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <TextBlock Text="No actions match your search."
                                           Visibility="{Binding ShowStepActionEmptyState, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                           Margin="12,4,12,8" TextAlignment="Center"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="280" Margin="0,0,2,4">
                                    <ItemsControl ItemsSource="{Binding FilteredStepActions}"
                                                  ItemTemplate="{StaticResource StepActionMenuItemTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="20,10" Background="White"
                BorderBrush="{StaticResource SurfaceBorderBrush}" BorderThickness="1,1,0,0">
            <TextBlock x:Name="Status" Text="Press [ESC] to stop a recording session."
                        Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        </Border>
    </Grid>
</Window>
